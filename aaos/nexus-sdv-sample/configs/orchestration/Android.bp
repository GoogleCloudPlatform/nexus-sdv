package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Orchestration configuration for PressureAdvisor service bundle.
prebuilt_etc {
    name: "com.nexussdv.pressure_advisor.orch.config",
    src: "pressure_advisor_config.textproto",
    // Subdirectory under which the file(s) to be installed into.
    sub_dir: "orch",
    // Filename is used in sdv service bundle metadata manifest.
    filename: "pressure_advisor.config",
    // Disable direct installation of the configuration to one of the partitions.
    // The configuration will be used only inside of service bundles registry apexes.
    installable: false,
}

// Orchestration configuration for DoorController service bundle.
prebuilt_etc {
    name: "com.nexussdv.door_controller.orch.config",
    src: "door_controller_config.textproto",
    // Subdirectory under which the file(s) to be installed into.
    sub_dir: "orch",
    // Filename is used in sdv service bundle metadata manifest.
    filename: "door_controller.config",
    // Disable direct installation of the configuration to one of the partitions.
    // The configuration will be used only inside of service bundles registry apexes.
    installable: false,
}

// Global (SDV VM instance) orchestration configurations.
// Path to file must be set with the `persist.sdv.orchestrator_config_path`
// system property.
// The `persist.sdv.orchestrator_config_path` system property specifies the path
// to the VM-level orchestration configuration file. Since this property can only
// point to a single file, if multiple VM-level configurations are autogenerated
// (e.g. from different catalogs), their contents must be merged into one file.
prebuilt_etc {
    name: "com_nexussdv_sample_orchestration_configurations",
    srcs: [
        // Configuration to start service bundles on boot.
        "vm_sample_orch_config.textproto",
    ],
    // Subdirectory under which the file(s) to be installed into.
    sub_dir: "orch",
}
