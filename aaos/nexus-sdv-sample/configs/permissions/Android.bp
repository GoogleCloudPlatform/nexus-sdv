    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Permissions policy for PressureAdvisor service bundle.
prebuilt_etc {
    name: "com.nexussdv.sample.PressureAdvisor.permissions.config",
    sub_dir: "permissions",
    src: "com.nexussdv.sample.PressureAdvisor.permissions.textproto",
    // Filename is used in sdv service bundle metadata manifest.
    filename: "com.nexussdv.sample.PressureAdvisor.permissions",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}

// Permissions policy for DoorController service bundle.
prebuilt_etc {
    name: "com.nexussdv.sample.DoorController.permissions.config",
    sub_dir: "permissions",
    src: "com.nexussdv.sample.DoorController.permissions.textproto",
    // Filename is used in sdv service bundle metadata manifest.
    filename: "com.nexussdv.sample.DoorController.permissions",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}
