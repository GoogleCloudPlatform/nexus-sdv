{{- $pki_strategy := .StateValues.pkiStrategy | default "local" }}
{{- $base_domain := .StateValues.baseDomain | default "" }}
repositories:
  - name: nats
    url: https://nats-io.github.io/k8s/helm/charts/

releases:
  - name: nats
    namespace: base-services
    createNamespace: true
    chart: "nats/nats"
    # Pinned: without a version every deployment takes whatever the NATS repo
    # publishes that day, so two platforms bootstrapped on different days run
    # different brokers. Chart and nats-server share the version number.
    version: "2.14.6"
    labels:
      app: nats
    installed: true
    values:
      - ../nats/values.yaml
      - podTemplate:
          merge:
            metadata:
              annotations:
                checksum/auth-callout-password: '{{ requiredEnv "NATS_AUTH_CALLOUT_PASSWORD" | sha256sum }}'
      # Inline values to properly structure authorization config
      - config:
          merge:
            leafnodes:
              listen: 0.0.0.0:7422
              # Every leaf node gets the server's INFO greeting before it has
              # authenticated, and that greeting names an address the leaf keeps as a
              # reconnect target. By default it is the pod's internal address — useless
              # to a vehicle behind the load balancer, where every reconnect first times
              # out against it, and disclosed to anyone who opens port 7422. Advertise
              # the public name instead. `no_advertise` does not do this: measured
              # against nats-server 2.14.2 and 2.14.6 it is ignored in this block and
              # rejected at the top level. Without a base domain (local PKI) the
              # default stays.
              {{- if $base_domain }}
              advertise: "nats.{{ $base_domain }}:7422"
              {{- end }}
            # Accounts. NEXUS is where everything Nexus-side lives: the vehicles (the callout
            # places every vehicle connection here — its issued JWT names NEXUS as audience),
            # the connector and the consumers behind it, the grant store and the registry.
            # It is a named account because the default global account cannot have
            # JetStream once any other account is defined (nats-server; spec D8, 2026-09-29),
            # and JetStream is where the registry's buckets live — and, from Increment 2.5
            # on, where store-and-forward for the vehicles will. AUTH holds the callout
            # service, APP the basic user, SYS the server itself.
            accounts:
              NEXUS:
                jetstream: enabled
                users:
                  - user: connector
                    password: '{{ requiredEnv "NATS_CONNECTOR_PASSWORD" }}'
                    permissions:
                      # pubsub.> on subscribe for Increment 1.2's nexus-pubsub-consumer (finding F29:
                      # this grant lived on a feature branch and a deploy from main removed it); on
                      # publish since Increment 2.2 so a cloud-side test can send a command. The
                      # split into per-consumer identities stays scheduled for release 1.3.
                      subscribe: ["telemetry.>", "telemetry-aaos-sdv.>", "telemetry-generic.>", "local.telemetry.>", "scoring.>", "pubsub.>"]
                      publish: ["telemetry.>", "telemetry-aaos-sdv.>", "telemetry-generic.>", "local.telemetry.>", "scoring.>", "pubsub.>"]
                  - user: grant-reader
                    password: '{{ requiredEnv "NATS_GRANT_READER_PASSWORD" }}'
                    permissions:
                      # Reads the per-VIN grants for the auth-callout (Increment 2.2). JetStream's
                      # request subjects are the only publishes it needs; replies come on its inbox.
                      publish: ["$JS.API.STREAM.INFO.KV_nexus-registry-grants", "$JS.API.DIRECT.GET.KV_nexus-registry-grants.>", "$JS.API.STREAM.MSG.GET.KV_nexus-registry-grants"]
                      subscribe: ["_INBOX_grant_reader.>"]
                  - user: nexus-registry
                    password: '{{ requiredEnv "NATS_REGISTRY_PASSWORD" }}'
                    permissions:
                      # The Cloud Service Registry (Increment 2.2): its three buckets —
                      # registrations, offers, grants — and the control subjects. Broad on
                      # the JetStream API on purpose: it creates its buckets at start-up.
                      publish: ["$JS.API.>", "$KV.nexus-registry-grants.>", "$KV.nexus-registry-offers.>", "$KV.nexus-registry-services.>", "registry.>"]
                      subscribe: ["_INBOX.>", "registry.>"]
              AUTH:
                users:
                  - user: auth-callout-service
                    password: '{{ requiredEnv "NATS_AUTH_CALLOUT_PASSWORD" }}'
              APP:
                users:
                  - user: '{{ requiredEnv "NATS_BASIC_AUTH_USER" }}'
                    password: '{{ requiredEnv "NATS_BASIC_AUTH_PASSWORD" }}'
              SYS: {}
            # Specify system account for NATS server operations
            system_account: SYS
            # Authorization: every connection not listed in auth_users goes through the callout
            authorization:
              auth_callout:
                issuer: '{{ requiredEnv "NATS_AUTH_CALLOUT_NKEY_PUB" }}'
                # auth_users lists users who BYPASS the callout (authenticate directly)
                # All users NOT in this list will go through the callout (e.g., vehicles with JWTs)
                auth_users:
                  - auth-callout-service                      # Auth service bypasses to respond to requests
                  - connector                                 # Connector authenticates directly with password
                  - grant-reader                              # Reads grants for the callout, by password
                  - nexus-registry                            # The registry, by password
                  - '{{ requiredEnv "NATS_BASIC_AUTH_USER" }}' # Basic auth user bypasses callout
                account: AUTH
    set:
      - name: "podTemplate.merge.spec.affinity.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution.nodeSelectorTerms[0].matchExpressions[0].values[0]"
        value: {{ .StateValues.arch | default "arm64" }}
      - name: "natsBox.podTemplate.merge.spec.affinity.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution.nodeSelectorTerms[0].matchExpressions[0].values[0]"
        value: {{ .StateValues.arch | default "arm64" }}
      {{- if eq (.StateValues.arch | default "arm64") "arm64" }}
      # arm64 on Autopilot must name a compute-class; autopilot-arm is the
      # container-optimized Arm class (backed by C4A). Appended only for arm64 so
      # amd64 deployments use default provisioning (no compute-class). Added here
      # rather than in values.yaml because values.yaml is arch-agnostic and the
      # arch is only known per-deploy.
      - name: "podTemplate.merge.spec.affinity.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution.nodeSelectorTerms[0].matchExpressions[1].key"
        value: cloud.google.com/compute-class
      - name: "podTemplate.merge.spec.affinity.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution.nodeSelectorTerms[0].matchExpressions[1].operator"
        value: In
      - name: "podTemplate.merge.spec.affinity.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution.nodeSelectorTerms[0].matchExpressions[1].values[0]"
        value: autopilot-arm
      - name: "natsBox.podTemplate.merge.spec.affinity.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution.nodeSelectorTerms[0].matchExpressions[1].key"
        value: cloud.google.com/compute-class
      - name: "natsBox.podTemplate.merge.spec.affinity.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution.nodeSelectorTerms[0].matchExpressions[1].operator"
        value: In
      - name: "natsBox.podTemplate.merge.spec.affinity.nodeAffinity.requiredDuringSchedulingIgnoredDuringExecution.nodeSelectorTerms[0].matchExpressions[1].values[0]"
        value: autopilot-arm
      {{- end }}
      - name: pkiStrategy
        value: {{ .StateValues.pkiStrategy | default "local" }}
      {{- if eq $pki_strategy "remote" }}
      - name: baseDomain
        value: '{{ requiredEnv "BASE_DOMAIN" }}'
      - name: service.merge.metadata.annotations.external-dns\.alpha\.kubernetes\.io/hostname
        value: 'nats.{{ requiredEnv "BASE_DOMAIN" }}'
      {{- else }}
      - name: baseDomain
        value: ""
      {{- end }}
      # User credentials for reference (kept for compatibility)
      - name: natsUsers.basic.username
        value: '{{ requiredEnv "NATS_BASIC_AUTH_USER" }}'
      - name: natsUsers.basic.password
        value: '{{ requiredEnv "NATS_BASIC_AUTH_PASSWORD" }}'
      - name: natsUsers.authCallout.username
        value: 'auth-callout-service'
      - name: natsUsers.authCallout.password
        value: '{{ requiredEnv "NATS_AUTH_CALLOUT_PASSWORD" }}'
      - name: natsUsers.connector.username
        value: 'connector'
      - name: natsUsers.connector.password
        value: '{{ requiredEnv "NATS_CONNECTOR_PASSWORD" }}'
      - name: environment
        value: '{{ env "ENVIRONMENT" | default "dev" }}'
    {{- if eq $pki_strategy "remote" }}
    setString:
      - name: service.merge.metadata.annotations.external-dns\.alpha\.kubernetes\.io/ttl
        value: "300"
    {{- end }}
