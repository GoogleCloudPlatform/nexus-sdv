repositories:
  - name: external-secrets
    url: https://charts.external-secrets.io

releases:
  - name: external-secrets
    namespace: external-secrets-system
    createNamespace: true
    chart: external-secrets/external-secrets
    version: "0.9.9"
    labels:
      app: external-secrets
    installed: true
    values:
      - serviceAccount:
          create: true
          name: external-secrets
        # Workload Identity annotation will be added separately by GCP terraform
        #
        # Resource requests: GKE Autopilot defaults to 500m CPU / 2Gi memory per pod
        # when no requests are set. The external-secrets controllers are small Go
        # binaries that use ~30-50MB. Explicit requests prevent Autopilot from
        # over-provisioning (3 pods × 2Gi = 6Gi wasted).
        resources:
          requests:
            cpu: 50m
            memory: 128Mi
          limits:
            memory: 256Mi
        webhook:
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              memory: 256Mi
        certController:
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              memory: 256Mi
